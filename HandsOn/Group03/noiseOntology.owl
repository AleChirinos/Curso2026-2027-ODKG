<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:dcterms="http://purl.org/dc/terms/"
    xmlns:mn="https://madridnoise.linkeddata.es/ontology#"
    xmlns:sosa="http://www.w3.org/ns/sosa/"
    xmlns:geo="http://www.w3.org/2003/01/geo/wgs84_pos#">

  <!-- Ontology -->

  <owl:Ontology rdf:about="https://madridnoise.linkeddata.es/ontology">
    <dcterms:title xml:lang="en">Madrid urban noise ontology</dcterms:title>
    <dcterms:description xml:lang="en">
      Ontology for daily acoustic pollution measurements from the Madrid noise
      monitoring network, together with registered hospitality terraces.
    </dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:source rdf:resource="https://datos.madrid.es/dataset/215885-0-contaminacion-ruido"/>
    <dcterms:source rdf:resource="https://datos.madrid.es/dataset/211346-0-estaciones-acusticas"/>
    <dcterms:source rdf:resource="https://datos.madrid.es/dataset/200085-0-censo-locales"/>
    <owl:versionInfo>1.0</owl:versionInfo>
    <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>
  </owl:Ontology>

  <!-- Classes -->

  <owl:Class rdf:about="https://madridnoise.linkeddata.es/ontology#NoiseMonitoringStation">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
    <rdfs:label xml:lang="en">Noise monitoring station</rdfs:label>
    <rdfs:label xml:lang="es">Estación de medida de ruido</rdfs:label>
    <rdfs:comment xml:lang="en">
      Station belonging to the Madrid acoustic pollution monitoring network.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://madridnoise.linkeddata.es/ontology#DailyNoiseObservation">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:label xml:lang="en">Daily noise observation</rdfs:label>
    <rdfs:label xml:lang="es">Observación diaria de ruido</rdfs:label>
    <rdfs:comment xml:lang="en">
      Acoustic indicators measured for one station, one date and one period.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://madridnoise.linkeddata.es/ontology#DayPeriod">
    <rdfs:label xml:lang="en">Period of the day</rdfs:label>
    <rdfs:label xml:lang="es">Periodo del día</rdfs:label>
    <rdfs:comment xml:lang="en">
      Controlled period used by the daily noise dataset: D, E, N or T.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://madridnoise.linkeddata.es/ontology#Terrace">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
    <rdfs:label xml:lang="en">Hospitality terrace</rdfs:label>
    <rdfs:label xml:lang="es">Terraza de hostelería</rdfs:label>
    <rdfs:comment xml:lang="en">
      Registered hospitality or restaurant terrace used as the second source
      for the spatial analysis.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="https://madridnoise.linkeddata.es/ontology#District">
    <rdfs:label xml:lang="en">District</rdfs:label>
    <rdfs:label xml:lang="es">Distrito</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="https://madridnoise.linkeddata.es/ontology#Neighbourhood">
    <rdfs:label xml:lang="en">Neighbourhood</rdfs:label>
    <rdfs:label xml:lang="es">Barrio</rdfs:label>
  </owl:Class>

  <!-- Object properties -->

  <owl:ObjectProperty rdf:about="https://madridnoise.linkeddata.es/ontology#recordedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://madridnoise.linkeddata.es/ontology#DailyNoiseObservation"/>
    <rdfs:range rdf:resource="https://madridnoise.linkeddata.es/ontology#NoiseMonitoringStation"/>
    <rdfs:label xml:lang="en">recorded at</rdfs:label>
    <rdfs:comment xml:lang="en">Station that recorded the observation.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://madridnoise.linkeddata.es/ontology#forPeriod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://madridnoise.linkeddata.es/ontology#DailyNoiseObservation"/>
    <rdfs:range rdf:resource="https://madridnoise.linkeddata.es/ontology#DayPeriod"/>
    <rdfs:label xml:lang="en">for period</rdfs:label>
    <rdfs:comment xml:lang="en">Period to which the acoustic indicators refer.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://madridnoise.linkeddata.es/ontology#hasDistrict">
    <rdfs:domain rdf:resource="https://madridnoise.linkeddata.es/ontology#Terrace"/>
    <rdfs:range rdf:resource="https://madridnoise.linkeddata.es/ontology#District"/>
    <rdfs:label xml:lang="en">has district</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://madridnoise.linkeddata.es/ontology#hasNeighbourhood">
    <rdfs:domain rdf:resource="https://madridnoise.linkeddata.es/ontology#Terrace"/>
    <rdfs:range rdf:resource="https://madridnoise.linkeddata.es/ontology#Neighbourhood"/>
    <rdfs:label xml:lang="en">has neighbourhood</rdfs:label>
  </owl:ObjectProperty>

  <!-- Station data properties -->

  <owl:DatatypeProperty rdf:about="https://madridnoise.linkeddata.es/ontology#stationCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://madridnoise.linkeddata.es/ontology#NoiseMonitoringStation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">station code</rdfs:label>
    <rdfs:comment xml:lang="en">
      Canonical station identifier, for example RF-02. Numeric measurement
      codes are normalized to this form.
    </rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://madridnoise.linkeddata.es/ontology#stationName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://madridnoise.linkeddata.es/ontology#NoiseMonitoringStation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">station name</rdfs:label>
  </owl:DatatypeProperty>

  <!-- Observation data properties -->

  <owl:DatatypeProperty rdf:about="https://madridnoise.linkeddata.es/ontology#observationDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://madridnoise.linkeddata.es/ontology#DailyNoiseObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:label xml:lang="en">observation date</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://madridnoise.linkeddata.es/ontology#periodCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://madridnoise.linkeddata.es/ontology#DayPeriod"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">period code</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://madridnoise.linkeddata.es/ontology#laeq">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://madridnoise.linkeddata.es/ontology#DailyNoiseObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">LAeq</rdfs:label>
    <rdfs:comment xml:lang="en">Equivalent continuous A-weighted sound level, in dB(A).</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://madridnoise.linkeddata.es/ontology#las01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://madridnoise.linkeddata.es/ontology#DailyNoiseObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">LAS01</rdfs:label>
    <rdfs:comment xml:lang="en">Level exceeded 1% of the time, in dB(A).</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://madridnoise.linkeddata.es/ontology#las10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://madridnoise.linkeddata.es/ontology#DailyNoiseObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">LAS10</rdfs:label>
    <rdfs:comment xml:lang="en">Level exceeded 10% of the time, in dB(A).</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://madridnoise.linkeddata.es/ontology#las50">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://madridnoise.linkeddata.es/ontology#DailyNoiseObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">LAS50</rdfs:label>
    <rdfs:comment xml:lang="en">Level exceeded 50% of the time, in dB(A).</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://madridnoise.linkeddata.es/ontology#las90">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://madridnoise.linkeddata.es/ontology#DailyNoiseObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">LAS90</rdfs:label>
    <rdfs:comment xml:lang="en">Level exceeded 90% of the time, in dB(A).</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://madridnoise.linkeddata.es/ontology#las99">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://madridnoise.linkeddata.es/ontology#DailyNoiseObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">LAS99</rdfs:label>
    <rdfs:comment xml:lang="en">Level exceeded 99% of the time, in dB(A).</rdfs:comment>
  </owl:DatatypeProperty>

  <!-- Terrace data property -->

  <owl:DatatypeProperty rdf:about="https://madridnoise.linkeddata.es/ontology#terraceId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://madridnoise.linkeddata.es/ontology#Terrace"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">terrace identifier</rdfs:label>
    <rdfs:comment xml:lang="en">Value of id_terraza in the source census.</rdfs:comment>
  </owl:DatatypeProperty>

  <!-- Geographic properties. These reuse WGS84 vocabulary through subproperties. -->

  <owl:DatatypeProperty rdf:about="https://madridnoise.linkeddata.es/ontology#latitude">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#lat"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">latitude</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://madridnoise.linkeddata.es/ontology#longitude">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#long"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">longitude</rdfs:label>
  </owl:DatatypeProperty>

  <!-- Period individuals -->

  <owl:NamedIndividual rdf:about="https://madridnoise.linkeddata.es/resource/period/D">
    <rdf:type rdf:resource="https://madridnoise.linkeddata.es/ontology#DayPeriod"/>
    <rdfs:label xml:lang="en">Day (07:00-19:00)</rdfs:label>
    <mn:periodCode>D</mn:periodCode>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://madridnoise.linkeddata.es/resource/period/E">
    <rdf:type rdf:resource="https://madridnoise.linkeddata.es/ontology#DayPeriod"/>
    <rdfs:label xml:lang="en">Evening (19:00-23:00)</rdfs:label>
    <mn:periodCode>E</mn:periodCode>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://madridnoise.linkeddata.es/resource/period/N">
    <rdf:type rdf:resource="https://madridnoise.linkeddata.es/ontology#DayPeriod"/>
    <rdfs:label xml:lang="en">Night (23:00-07:00)</rdfs:label>
    <mn:periodCode>N</mn:periodCode>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="https://madridnoise.linkeddata.es/resource/period/T">
    <rdf:type rdf:resource="https://madridnoise.linkeddata.es/ontology#DayPeriod"/>
    <rdfs:label xml:lang="en">Total (24h)</rdfs:label>
    <mn:periodCode>T</mn:periodCode>
  </owl:NamedIndividual>

</rdf:RDF>
