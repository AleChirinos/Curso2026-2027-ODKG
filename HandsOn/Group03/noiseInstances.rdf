<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:dcterms="http://purl.org/dc/terms/"
    xmlns:dcat="http://www.w3.org/ns/dcat#"
    xmlns:mn="https://madridnoise.linkeddata.es/ontology#"
    xmlns:station="https://madridnoise.linkeddata.es/resource/station/"
    xmlns:observation="https://madridnoise.linkeddata.es/resource/observation/"
    xmlns:terrace="https://madridnoise.linkeddata.es/resource/terrace/"
    xmlns:district="https://madridnoise.linkeddata.es/resource/district/"
    xmlns:neighbourhood="https://madridnoise.linkeddata.es/resource/neighbourhood/"
    xmlns:period="https://madridnoise.linkeddata.es/resource/period/"
    xmlns:dataset="https://madridnoise.linkeddata.es/dataset/"
    xmlns:geo="http://www.w3.org/2003/01/geo/wgs84_pos#">

  <!-- Dataset metadata -->

  <dcat:Dataset rdf:about="https://madridnoise.linkeddata.es/dataset/daily-noise">
    <dcterms:title xml:lang="en">Madrid daily noise measurements (Linked Data)</dcterms:title>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:rightsHolder rdf:resource="http://datos.gob.es/recurso/sector-publico/org/Organismo/L01280796"/>
    <dcterms:source rdf:resource="https://datos.madrid.es/dataset/215885-0-contaminacion-ruido"/>
    <dcterms:source rdf:resource="https://datos.madrid.es/dataset/211346-0-estaciones-acusticas"/>
    <dcterms:source rdf:resource="https://datos.madrid.es/dataset/200085-0-censo-locales"/>
  </dcat:Dataset>

  <!-- Station. The canonical identifier follows analysis.html: numeric 2 -> RF-02. -->

  <mn:NoiseMonitoringStation rdf:about="https://madridnoise.linkeddata.es/resource/station/RF-02">
    <rdfs:label xml:lang="en">Carlos V</rdfs:label>
    <mn:stationCode>RF-02</mn:stationCode>
  </mn:NoiseMonitoringStation>

  <!-- Controlled period resources -->

  <mn:DayPeriod rdf:about="https://madridnoise.linkeddata.es/resource/period/D">
    <rdfs:label xml:lang="en">Day (07:00-19:00)</rdfs:label>
    <mn:periodCode>D</mn:periodCode>
  </mn:DayPeriod>

  <mn:DayPeriod rdf:about="https://madridnoise.linkeddata.es/resource/period/E">
    <rdfs:label xml:lang="en">Evening (19:00-23:00)</rdfs:label>
    <mn:periodCode>E</mn:periodCode>
  </mn:DayPeriod>

  <mn:DayPeriod rdf:about="https://madridnoise.linkeddata.es/resource/period/N">
    <rdfs:label xml:lang="en">Night (23:00-07:00)</rdfs:label>
    <mn:periodCode>N</mn:periodCode>
  </mn:DayPeriod>

  <mn:DayPeriod rdf:about="https://madridnoise.linkeddata.es/resource/period/T">
    <rdfs:label xml:lang="en">Total (24h)</rdfs:label>
    <mn:periodCode>T</mn:periodCode>
  </mn:DayPeriod>

  <!-- Observation examples.
       The analysis.html defines this URI pattern. Numerical measurement values
       are deliberately omitted here because they are not present in the HTML. -->

  <mn:DailyNoiseObservation rdf:about="https://madridnoise.linkeddata.es/resource/observation/RF-02-2020-01-01-D">
    <mn:recordedAt rdf:resource="https://madridnoise.linkeddata.es/resource/station/RF-02"/>
    <mn:forPeriod rdf:resource="https://madridnoise.linkeddata.es/resource/period/D"/>
    <mn:observationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-01-01</mn:observationDate>
  </mn:DailyNoiseObservation>

  <mn:DailyNoiseObservation rdf:about="https://madridnoise.linkeddata.es/resource/observation/RF-02-2020-01-01-N">
    <mn:recordedAt rdf:resource="https://madridnoise.linkeddata.es/resource/station/RF-02"/>
    <mn:forPeriod rdf:resource="https://madridnoise.linkeddata.es/resource/period/N"/>
    <mn:observationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-01-01</mn:observationDate>
  </mn:DailyNoiseObservation>

  <!-- Terrace example using the source identifier documented in analysis.html. -->

  <mn:Terrace rdf:about="https://madridnoise.linkeddata.es/resource/terrace/37">
    <rdfs:label xml:lang="en">Terrace 37</rdfs:label>
    <mn:terraceId rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">37</mn:terraceId>
    <mn:hasDistrict rdf:resource="https://madridnoise.linkeddata.es/resource/district/18"/>
    <mn:hasNeighbourhood rdf:resource="https://madridnoise.linkeddata.es/resource/neighbourhood/1801"/>
  </mn:Terrace>

  <mn:District rdf:about="https://madridnoise.linkeddata.es/resource/district/18">
    <rdfs:label xml:lang="en">Villa de Vallecas</rdfs:label>
  </mn:District>

  <mn:Neighbourhood rdf:about="https://madridnoise.linkeddata.es/resource/neighbourhood/1801">
    <rdfs:label xml:lang="en">Neighbourhood 1801</rdfs:label>
  </mn:Neighbourhood>

</rdf:RDF>
